# Supabase project settings
# Use the project's public URL and publishable/anon key only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only secret. Set this only in Render environment variables if/when
# a trusted server operation genuinely requires it. Never expose it publicly.
# SUPABASE_SERVICE_ROLE_KEY=

# Public production origin used for auth callbacks (not a secret)
NEXT_PUBLIC_SITE_URL=https://eveora.onrender.com

# Server-only AI assistant credentials (never use NEXT_PUBLIC_ prefix)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Paystack TEST MODE only. Keep the secret key server-side (never NEXT_PUBLIC_).
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_PAYSTACK_TEST_SECRET

# Server-only Supabase service role key, used by verified payment webhook/admin workflows.
# Never expose this key in browser code or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated admin email addresses. Only these accounts can access /admin.
ADMIN_EMAILS=
