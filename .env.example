# Supabase project settings
# Use the project's public URL and publishable/anon key only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only secret. Set this only in Render environment variables if/when
# a trusted server operation genuinely requires it. Never expose it publicly.
# SUPABASE_SERVICE_ROLE_KEY=
